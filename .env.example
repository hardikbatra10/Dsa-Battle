# Copy to .env and fill in. .env is gitignored; never commit real values.
# These five are the ONLY variables config/settings.py reads.

# Django
SECRET_KEY=replace-me
DEBUG=False

# Postgres. settings.py reads DATABASE_URL and nothing else - individual
# DB_NAME / DB_USER / DB_HOST style variables are NOT used and will be
# silently ignored. Neon connection strings must keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Judge0 on RapidAPI, used by submissions/services/judge0.py
RAPIDAPI_KEY=replace-me
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
