# Copy to .env and fill in. .env is gitignored; never commit real values.

# Django
SECRET_KEY=replace-me
DEBUG=False

# Postgres. settings.py reads DATABASE_URL and nothing else - individual
# DB_NAME / DB_USER / DB_HOST style variables are NOT used and will be
# silently ignored. Neon connection strings must keep ?sslmode=require.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Judge0 on RapidAPI, used by submissions/services/judge0.py
RAPIDAPI_KEY=replace-me
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Firebase, for room chat and Google sign-in. See firebase/README.md.
# Optional: without it the rest of the app runs unchanged, Google sign-in
# returns 503, and the chat panel says it is unavailable.
#
# This is the ONLY Firebase value the backend needs. It is public: it names
# the project so a Google sign-in token's audience can be checked against it.
# Verification uses Google's public certificates, so there is no service
# account key, and the backend never touches the database itself.
FIREBASE_PROJECT_ID=your-project-id
