VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase web config, from Project settings -> General -> Your apps.
# These values are public by design: they name the project, they do not grant
# access. What protects the chat data is firebase/database.rules.json.
# Leave them blank to run without chat or Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Optional: unused by chat and auth, carried through for Storage/messaging.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
